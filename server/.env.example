# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────
# With Docker (docker-compose.yml at repo root):
#   With auth:    MONGO_URL=mongodb://root:rootpassword@localhost:27017
#   Without auth: MONGO_URL=mongodb://localhost:27017
# The server appends /PortalAcademia as the database name automatically.
MONGO_URL=

# ── JWT ──────────────────────────────────────
# Any long random string — keep it secret!
JWT_PASS_KEY=your_super_secret_jwt_key_here

# ── Nodemailer (Gmail) ────────────────────────
# The Gmail account used to send OTP emails.
# Use an App Password, NOT your real Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL=your_gmail@gmail.com
PASSWORD=your_gmail_app_password

# ── CORS ─────────────────────────────────────
# URL of the running Vite client dev server
FRONTEND_URL=http://localhost:5173

# ── Session & Google OAuth ────────────────────
SESSION_SECRET=your_session_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACKURL=http://localhost:3000/api/auth/google/callback

# ── Cloudinary ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AISHE & AI APIs ───────────────────────────
AISHE_API_KEY=your_aishe_api_key
GROK_API_KEY=your_grok_xai_api_key

# ── Redis Cache (Optional, defaults to redis://127.0.0.1:6379 with in-memory fallback) ────
REDIS_URL=redis://127.0.0.1:6379
